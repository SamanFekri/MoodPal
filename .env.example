# .env.example
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=MoodPalBot
MONGODB_URI=mongo_uri_here
MAIN_CHANNEL_ID=channel_id_here
MAIN_CHANNEL_USERNAME=channel_username_here
OLAF_CHANNEL_ID=-olaf_channel_id_here
CRON_JOB_TIME="* 7,21 * * *"
WEEKLY_CRON_JOB_TIME="0 7 * * 1"

# HTTP server (API, embeds and the Telegram miniapp)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Public URL of the server. Defaults to https://moodpal.samanfekri.me if unset.
SERVER_BASE_URL=https://moodpal.samanfekri.me

# AI insights use each user's own OpenAI key (set via /set_openai_key in the bot).
# Keys are stored encrypted with this secret; falls back to BOT_TOKEN if unset.
KEY_ENCRYPTION_SECRET=change_me_to_a_long_random_string
